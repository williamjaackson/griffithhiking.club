---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Statement from "../components/Statement.astro";
import PhotoRail from "../components/PhotoRail.astro";
import Events from "../components/Events.astro";
import Instagram from "../components/Instagram.astro";
import Invitation from "../components/Invitation.astro";
import Footer from "../components/Footer.astro";
import TrailPassTab from "../components/TrailPassTab.astro";
import TrailPassBand from "../components/TrailPassBand.astro";
import Curtain from "../components/Curtain.astro";
import JoinDialog from "../components/JoinDialog.astro";
---

<Base
  title="Griffith Hiking Club"
  description="Weekend hiking adventures with Griffith University students across South East Queensland."
>
  <Hero />
  <Statement />
  <PhotoRail />
  <Events />
  <TrailPassBand />
  <Instagram />
  <Invitation />
  <Footer slot="footer" />
  <TrailPassTab />
  <Curtain />
  <JoinDialog />
</Base>
