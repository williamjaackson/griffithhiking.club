---
/** The olive splash the trail pass opens behind.
 *
 *  Covers the page from its own first paint and lifts on a timer, in CSS alone,
 *  so what is behind it is never shown first no matter how somebody arrived - by
 *  a link, by a reload, or by typing the address in.
 *
 *  Additive: without CSS there is nothing here but a hidden decoration.
 */
---

{
  /* Rendered rather than built in script, so its colour and stacking stay in the
    stylesheet. Anything slotted in rides on it while it covers - which is how the
    trail pass gets its opening mark without a second full-screen overlay of its
    own. */
}
<div class="curtain" aria-hidden="true">
  <slot />
</div>

<style>
  /* Above everything, and taking no pointer events even while it covers: the page
     under it is ready the moment it paints, and the splash is only a picture. */
  .curtain {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    background: var(--color-olive);
    color: var(--color-cream);
    pointer-events: none;
    animation: curtain-lift var(--duration-slow) var(--ease-soft)
      var(--duration-splash) both;
  }

  /* visibility, not opacity alone: once it has cleared it has to stop painting
     over the page, whatever the stacking says. */
  @keyframes curtain-lift {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* Nothing here is information, so there is nothing worth holding anybody up for. */
  @media (prefers-reduced-motion: reduce) {
    .curtain {
      display: none;
    }
  }
</style>
