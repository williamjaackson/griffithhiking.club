---
import {
  DIFFICULTY_LABELS,
  difficultyRank,
  type Difficulty,
} from "../lib/events";

/** How hard a hike is, drawn as bootprints.
 *
 *  One icon repeated, one to five times, in a colour that runs green to red.
 *  Two signals carrying the same meaning: the count can be read precisely, the
 *  colour can be read at a glance, and neither depends on the other - which is
 *  what keeps the scale legible to anyone who cannot separate the hues.
 *
 *  Rating a trail in boots is the convention this borrows from, and it beats a
 *  row of neutral dots for the same reason a ridgeline did: it belongs to the
 *  thing being described.
 *
 *  The label is a tooltip rather than standing text. It would otherwise repeat
 *  down the list and compete with the destinations, which are what the list is
 *  actually for.
 */
interface Props {
  level: Difficulty;
}

const { level } = Astro.props;
const label = DIFFICULTY_LABELS[level];
const prints = Array.from({ length: difficultyRank(level) }, (_, i) => i);
---

{
  /* role and label carry the whole meaning, so the drawing and the visible
    tooltip are both hidden from assistive technology rather than repeated.
    Focusable so the tooltip is reachable without a pointer. */
}
<span
  class="grade"
  data-level={level}
  role="img"
  aria-label={`Difficulty: ${label}`}
  tabindex="0"
>
  {
    prints.map((i) => (
      <svg
        class="grade__print"
        data-step={i % 2}
        viewBox="0 0 16 20"
        aria-hidden="true"
        focusable="false"
      >
        {/* Sole and heel as two shapes: a single blob loses its footprint at
            this size, the gap between them is what makes it read. */}
        <ellipse cx="8" cy="6.4" rx="5.2" ry="6.2" />
        <ellipse cx="8" cy="16.6" rx="3.9" ry="3.3" />
      </svg>
    ))
  }
  <span class="grade__label caption" aria-hidden="true">{label}</span>
</span>

<style>
  .grade {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    /* The ramp is selected once here and inherited by the prints below, so a
       grade's colour is set in exactly one place. */
    color: var(--grade-ink);
  }

  .grade[data-level="easy"] {
    --grade-ink: var(--color-grade-easy);
  }
  .grade[data-level="easy-moderate"] {
    --grade-ink: var(--color-grade-easy-moderate);
  }
  .grade[data-level="moderate"] {
    --grade-ink: var(--color-grade-moderate);
  }
  .grade[data-level="moderate-hard"] {
    --grade-ink: var(--color-grade-moderate-hard);
  }
  .grade[data-level="hard"] {
    --grade-ink: var(--color-grade-hard);
  }

  /* Sized in em so the prints track whatever text sits beside them. */
  .grade__print {
    width: 0.72em;
    height: 0.9em;
    fill: currentColor;
    flex: none;
  }

  /* Alternating prints sit a touch lower, so a row of them reads as a track
     across the ground rather than a row of identical marks. */
  .grade__print[data-step="1"] {
    translate: 0 0.16em;
  }

  /* A tooltip: the grade is supporting information, and printing it beside
     every entry would crowd out the destinations. Inverted from the tone it
     sits on, so it works on the photo card and the paper list alike. */
  .grade__label {
    position: absolute;
    bottom: calc(100% + 0.45rem);
    left: 0;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--tone-fg);
    color: var(--tone-bg);
    white-space: nowrap;
    opacity: 0;
    translate: 0 0.25rem;
    pointer-events: none;
    transition:
      opacity var(--duration-base) ease,
      translate var(--duration-base) var(--ease-soft);
  }

  .grade:hover .grade__label,
  .grade:focus-visible .grade__label {
    opacity: 1;
    translate: 0 0;
  }
</style>
