---
import { getCollection } from "astro:content";
import Rail from "./Rail.astro";
import PhotoLink from "./PhotoLink.astro";

const frames = (await getCollection("moments")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="py-section" data-tone="ink" aria-label="Club moments">
  <Rail>
    {
      frames.map((f) => (
        <figure>
          <PhotoLink
            photo={f.data.photo}
            alt={f.data.alt}
            ratio="3 / 4"
            widths={[480, 780, 1100]}
            sizes="(min-width: 52rem) 30vw, 78vw"
          />
          <figcaption class="caption mt-3" style="color: var(--tone-accent)">
            {f.data.caption}
          </figcaption>
        </figure>
      ))
    }
  </Rail>
</section>
