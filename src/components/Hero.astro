---
import { Image, Picture } from "astro:assets";
import heroPhoto from "../assets/hero-pats-bluff.jpg";
import clubLogo from "../assets/club-logo.png";
import { links } from "../lib/links";
---

{
  /* Utilities carry anything that maps 1:1 to a single value. The scoped styles
    below carry only what would otherwise need an arbitrary value in a class
    attribute: gradients, clamp() sizes, writing-mode, keyframes. */
}
<section class="hero relative isolate h-svh overflow-hidden" data-tone="olive">
  {
    /* Decorative backdrop: the headline carries the message, and the scrim over
      it means the photo is atmosphere rather than information.
      Widths stop at 1170 because that is the source width - asking for more
      would only upscale. AVIF first, WebP next, JPEG as the floor. */
  }
  <Picture
    class="hero__photo absolute inset-0 -z-20 h-full w-full object-cover"
    src={heroPhoto}
    alt=""
    formats={["avif", "webp"]}
    fallbackFormat="jpeg"
    widths={[640, 960, 1170]}
    quality={70}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__scrim absolute inset-0 -z-10"></div>

  <nav class="absolute inset-0 z-20" aria-label="Club">
    <a class="absolute top-gutter-block left-gutter" href="/">
      <Image
        class="hero__mark aspect-square h-auto rounded-full object-cover mix-blend-screen"
        src={clubLogo}
        alt="Griffith Hiking Club"
        width={180}
        height={180}
        loading="eager"
      />
    </a>
    <a
      class="hero__cta absolute right-gutter bottom-gutter-block inline-flex items-center gap-control-gap px-control-inline py-control-block rounded-pill bg-cream text-olive-dark eyebrow whitespace-nowrap"
      href={links.campusGroups}
      target="_blank"
      rel="noreferrer"
      data-join
    >
      Join the club
      <svg
        class="hero__arrow"
        viewBox="0 0 20 20"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M3.5 10h13M11 4.5 16.5 10 11 15.5"></path>
      </svg>
    </a>
  </nav>

  <div class="hero__title absolute z-10 right-gutter left-gutter">
    <p class="eyebrow">Griffith Hiking Club · Gold Coast</p>
    <h1 class="hero__headline text-hero font-display mt-7 uppercase">
      Weekend<br />adventures.
    </h1>
  </div>

  <span
    class="hero__location caption absolute z-10 right-gutter opacity-85 max-sm:hidden"
    >Pats Bluff · Lamington NP · Sunset</span
  >
</section>

<style>
  /* svh tracks the visible viewport on mobile; the bounds keep the hero sane on
     a short laptop and a tall desktop, replacing the mockup's three variants. */
  .hero {
    min-height: 42rem;
    max-height: 56rem;
  }

  /* Keeps the group of hikers in frame as the crop narrows. */
  .hero__photo {
    object-position: 54% 48%;
  }

  /* Two layers, both derived from a token rather than literal colours:
     1. a vignette, pulling the corners down so the frame feels like a lens
        rather than a flat crop - deliberately weak, and fully clear through
        the middle where the photo does the work;
     2. the scrim, darkening towards the base so the headline holds contrast
        over any part of the photo underneath it. */
  .hero__scrim {
    background:
      radial-gradient(
        130% 90% at 50% 42%,
        transparent 70%,
        color-mix(in srgb, var(--color-black) 13%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-black) 6%, transparent),
        color-mix(in srgb, var(--color-black) 72%, transparent)
      );
  }

  .hero__mark {
    width: clamp(3.75rem, 3.25rem + 2vw, 5.5rem);
  }

  /* The pill's interaction stays here because its shadow needs color-mix, and
     splitting hover between markup and CSS would read worse than keeping it whole. */
  .hero__cta {
    animation-delay: 600ms;
    box-shadow: 0 0.9rem 2.2rem
      color-mix(in srgb, var(--color-ink) 34%, transparent);
    transition:
      transform var(--duration-base) var(--ease-soft),
      box-shadow var(--duration-base) ease,
      background-color var(--duration-base) ease;
  }

  .hero__cta:hover {
    transform: translateY(-2px);
    background-color: var(--color-white);
    box-shadow: 0 1.3rem 2.9rem
      color-mix(in srgb, var(--color-ink) 42%, transparent);
  }

  .hero__cta:active {
    transform: translateY(0) scale(0.985);
  }

  .hero__arrow {
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--duration-base) var(--ease-soft);
  }

  .hero__cta:hover .hero__arrow {
    transform: translateX(3px);
  }

  .hero__title {
    bottom: clamp(6rem, 4rem + 8vw, 9rem);
  }

  /* Caps have no descenders, so the token's 0.82 leading - calibrated for mixed
     case - reads loose here. Tightened to sit as close as the mockup. */
  .hero__headline {
    animation-delay: 320ms;
    line-height: 0.78;
  }

  .hero__location {
    top: 45%;
    writing-mode: vertical-rl;
  }

  /* Entrance: three distinct beats - club name, then headline, then pill - so
     each reads as arriving separately rather than as one movement. The offsets
     are large relative to the 700ms fade for exactly that reason. The caption is deliberately left
     out - it is a static credit, not part of the sequence.
     Animates `translate`, not `transform`: a filled animation holds whatever
     property it animates, and using `transform` here would silently kill the
     pill's hover lift and press. Neutered by the base layer's reduced-motion rule. */
  @keyframes hero-rise {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }

  .hero__title > *,
  .hero__cta {
    animation: hero-rise var(--duration-entrance) var(--ease-soft) both;
  }
</style>
