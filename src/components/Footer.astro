---
import { Picture } from "astro:assets";
import { getEntry } from "astro:content";
import { links } from "../lib/links";

/** The closing invitation.
 *
 *  The page has spent its length showing what the club does; this asks. So it
 *  carries one message and one action, at the largest type on the page after
 *  the hero, and nothing else competes with them.
 */
const home = await getEntry("home", "index");
const { footerPhoto, footerPhotoAlt, footerFocalPoint } = home!.data;
---

<footer class="footer" data-tone="olive">
  <Picture
    class="footer__photo photo-muted"
    style={`object-position: ${footerFocalPoint}`}
    src={footerPhoto}
    alt={footerPhotoAlt}
    formats={["avif", "webp"]}
    fallbackFormat="jpeg"
    widths={[640, 960, 1280]}
    sizes="(width >= 52rem) 55vw, 100vw"
    quality={70}
    loading="lazy"
  />

  <div class="footer__panel px-gutter">
    <p class="eyebrow" style="color: var(--tone-accent)">
      First hike or fiftieth
    </p>
    <h2 class="footer__title font-display mt-7 uppercase">
      Come<br />with us.
    </h2>
    <a
      class="footer__cta rounded-pill px-control-inline py-control-block gap-control-gap eyebrow bg-cream text-olive-dark mt-10 inline-flex w-fit items-center"
      href={links.campusGroups}
      target="_blank"
      rel="noreferrer"
      data-join
    >
      Become a member
    </a>
  </div>
</footer>

<style>
  /* Olive behind the photo as well as beside it, so the seam between the two
     halves never shows while the image is still loading. */
  .footer {
    display: grid;
    background: var(--tone-bg);
  }

  .footer__photo {
    width: 100%;
    height: min(70vh, 26rem);
    object-fit: cover;
  }

  .footer__panel {
    padding-block: var(--spacing-section);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* The tightest leading on the page. Caps have no descenders, so the two lines
     can close right up, which is what makes the phrase read as one block rather
     than two lines of a heading. */
  .footer__title {
    font-size: var(--text-section);
    line-height: 0.78;
  }

  .footer__cta {
    box-shadow: 0 0.9rem 2.2rem
      color-mix(in srgb, var(--color-ink) 26%, transparent);
    transition:
      transform var(--duration-base) var(--ease-soft),
      box-shadow var(--duration-base) ease,
      background-color var(--duration-base) ease;
  }

  .footer__cta:hover {
    transform: translateY(-2px);
    background-color: var(--color-white);
    box-shadow: 0 1.3rem 2.9rem
      color-mix(in srgb, var(--color-ink) 34%, transparent);
  }

  .footer__cta:active {
    transform: translateY(0) scale(0.985);
  }

  /* Side by side once there is room, with the photograph taking the larger
     share - it is the last thing the page shows of the club itself. */
  @media (width >= 52rem) {
    .footer {
      grid-template-columns: 1.15fr 1fr;
      align-items: stretch;
    }

    .footer__photo {
      height: 100%;
      min-height: 34rem;
    }
  }
</style>
