---
import { links } from "../lib/links";

/** The colophon.
 *
 *  Everything a visitor might want has already been offered above, so this is
 *  the legal line and the credits and nothing else - no second navigation, no
 *  repeated social links.
 *
 *  The year comes from the build. The site rebuilds nightly to roll the hike
 *  dates over, so it cannot be left behind on 1 January.
 */
const year = new Date().getFullYear();
---

<footer class="footer px-gutter" data-tone="ink">
  <div class="footer__inner mx-auto max-w-5xl">
    <p class="caption">© {year} Griffith Hiking Club. By students.</p>
    <p class="footer__credits caption">
      <a
        class="footer__link"
        href={links.builtBy}
        target="_blank"
        rel="noreferrer"
      >
        Built and operated by William Jackson
      </a>
      <a
        class="footer__link"
        href={links.university}
        target="_blank"
        rel="noreferrer"
      >
        Griffith University
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 2.25rem;
  }

  .footer__inner,
  .footer__credits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  /* Credits sit opposite the copyright once the row has room for both. */
  @media (width >= 40rem) {
    .footer__inner {
      justify-content: space-between;
    }
  }

  /* Quiet by default - this is the last thing on the page, not a destination -
     but it still has to clear contrast, so it dims rather than disappears. */
  .footer,
  .footer__link {
    color: color-mix(in srgb, var(--tone-fg) 62%, transparent);
  }

  .footer__link {
    text-decoration: none;
    transition: color var(--duration-base) ease;
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    color: var(--tone-fg);
  }
</style>
